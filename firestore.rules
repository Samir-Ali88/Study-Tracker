rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each signed-in student can only read and write their own profile
    // and their own progress subcollection.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /progress/{progressDoc} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Exams: any signed-in student can read; nobody can write from the app.
    match /exams/{examId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Past-paper questions: any signed-in student can read; nobody can write from the app.
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Notes: any signed-in student can read; nobody can create or delete from the app.
    // Updating is only allowed when ONLY voteCount increases by exactly 1
    // in the same atomic batch/transaction that creates the student's vote document.
    match /notes/{noteId} {
      allow read: if request.auth != null;
      allow create, delete: if false;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voteCount'])
        && request.resource.data.voteCount == resource.data.voteCount + 1
        && !exists(/databases/$(database)/documents/notes/$(noteId)/votes/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/notes/$(noteId)/votes/$(request.auth.uid));

      // Votes: any signed-in student can read; a student can ONLY create
      // a vote document whose ID equals their own uid. No updates or deletes.
      match /votes/{uid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update, delete: if false;
      }
    }
  }
}
